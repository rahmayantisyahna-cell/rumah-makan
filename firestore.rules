rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && resource.data.role == 'customer'
            && request.resource.data.role == 'customer');
      allow delete: if isAdmin();
    }

    // Aturan prototipe: semua akun yang sudah login dapat membaca/menulis
    // dokumen sinkronisasi. Untuk produksi, pisahkan data per koleksi/pengguna.
    match /appData/{document} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}
